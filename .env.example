# OpenWispr Environment Configuration
# Copy this file to .env and adjust values as needed for your Windows 11 deployment.
# All variables use the TRANSCRIPTA_ prefix as configured in app/core/config.py

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Application name displayed in UI and logs
# Default: OpenWispr
OPENWISPR_APP_NAME=OpenWispr

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# DEBUG enables verbose output for troubleshooting
# Default: INFO
TRANSCRIPTA_LOG_LEVEL=INFO

# Maximum log file size in bytes before rotation
# Logs rotate automatically when reaching this size
# Default: 1000000 (1 MB)
TRANSCRIPTA_LOG_MAX_BYTES=1000000

# Number of backup log files to keep
# Older files beyond this count are deleted
# Default: 5
TRANSCRIPTA_LOG_BACKUP_COUNT=5

# Root directory for session exports (transcripts, notes, formulas)
# Default: ./sessions
TRANSCRIPTA_EXPORT_ROOT=./sessions

# =============================================================================
# MODEL CONFIGURATION
# =============================================================================

# Whisper model size: tiny, base, small, medium, large-v3
# tiny/base = fastest, lower accuracy
# small = balanced (recommended for most GPUs)
# medium/large-v3 = best accuracy, requires more VRAM
# Default: medium
TRANSCRIPTA_DEFAULT_MODEL=medium

# Compute device: auto, cpu, cuda
# auto = detect CUDA and use if available, fallback to CPU
# cpu = force CPU execution
# cuda = force GPU execution (fails if CUDA unavailable)
# Default: auto
TRANSCRIPTA_DEVICE=auto

# Compute precision: float16, int8, int8_float16
# float16 = best speed on modern NVIDIA GPUs (RTX 20 series+)
# int8 = lower memory, slightly slower, works on CPU
# int8_float16 = mixed precision fallback
# Default: float16
TRANSCRIPTA_COMPUTE_TYPE=float16

# Model download/cache directory
# Whisper models are downloaded here on first run
# Default: ./models
TRANSCRIPTA_DOWNLOAD_ROOT=./models

# =============================================================================
# AUDIO SETTINGS
# =============================================================================

# Audio capture device ID for loopback recording
# Use 'python fix_headphone_capture.py' to list available devices
# Leave empty or unset to use the default output device (auto-detect)
# Examples: "0" (device index), "HyperX Cloud III" (device name), 
#           "{0.0.0.00000000}.{xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx}"
# Default: (empty - uses default output device)
TRANSCRIPTA_CAPTURE_DEVICE_ID=

# Audio sample rate in Hz
# 16000 is optimal for Whisper (its native training rate)
# Default: 16000
TRANSCRIPTA_SAMPLE_RATE=16000

# Audio channels: 1 for mono, 2 for stereo
# Mono is recommended for transcription
# Default: 1
TRANSCRIPTA_CHANNELS=1

# Audio chunk duration in seconds for processing
# Smaller = lower latency, more CPU/GPU overhead
# Larger = higher latency, more efficient
# Default: 3.2
TRANSCRIPTA_CHUNK_SECONDS=3.2

# Overlap between consecutive chunks in seconds
# Prevents word cuts at chunk boundaries
# Default: 0.6
TRANSCRIPTA_OVERLAP_SECONDS=0.6

# Audio capture block size in seconds
# Lower = more responsive, higher CPU usage
# Default: 0.03
TRANSCRIPTA_CAPTURE_BLOCK_SECONDS=0.03

# VU meter decay factor (0.0 - 1.0)
# Higher = slower decay, smoother meter
# Default: 0.85
TRANSCRIPTA_METER_DECAY=0.85

# =============================================================================
# VAD (VOICE ACTIVITY DETECTION) SETTINGS
# =============================================================================

# Enable VAD filtering to skip silent audio
# Reduces hallucinations and processing load
# Default: true
TRANSCRIPTA_VAD_FILTER=true

# VAD threshold (0.0 - 1.0)
# Higher = more aggressive silence detection
# Default: 0.5
TRANSCRIPTA_VAD_THRESHOLD=0.5

# Minimum silence duration to trigger split (milliseconds)
# Default: 200
TRANSCRIPTA_VAD_MIN_SILENCE_MS=200

# Padding added to speech segments (milliseconds)
# Default: 200
TRANSCRIPTA_VAD_SPEECH_PAD_MS=200

# =============================================================================
# TRANSCRIPTION SETTINGS
# =============================================================================

# Beam size for beam search decoding
# 1 = greedy decoding (fastest), higher = better quality, slower
# Default: 5
TRANSCRIPTA_BEAM_SIZE=5

# Number of candidates when sampling (best_of)
# 1 = deterministic, higher = explore alternatives
# Default: 5
TRANSCRIPTA_BEST_OF=5

# Sampling temperature (0.0 - 1.0)
# 0.0 = deterministic, higher = more randomness
# Default: 0.0
TRANSCRIPTA_TEMPERATURE=0.0

# Default language code (e.g., en, hi, auto)
# auto = automatic detection (may increase latency)
# Specific codes: en (English), hi (Hindi), etc.
# Default: auto
TRANSCRIPTA_DEFAULT_LANGUAGE=auto

# Live mode profile: realtime, low_latency, balanced, high_accuracy
# Affects chunk/overlap sizing
# Default: balanced
TRANSCRIPTA_DEFAULT_LIVE_MODE=balanced

# Execution mode: auto, gpu_only, cpu_only
# auto = use GPU if available, fallback to CPU
# gpu_only = fail if GPU unavailable
# cpu_only = always use CPU
# Default: auto
TRANSCRIPTA_DEFAULT_EXECUTION_MODE=auto

# =============================================================================
# QUEUE & PERFORMANCE SETTINGS
# =============================================================================

# Maximum STT queue items (backpressure threshold)
# When exceeded, oldest chunks are dropped
# Default: 16
TRANSCRIPTA_MAX_QUEUE_ITEMS=16

# Output refresh interval in seconds
# How often notes/formulas are rebuilt from transcript
# Default: 0.5
TRANSCRIPTA_OUTPUT_REFRESH_SECONDS=0.5

# =============================================================================
# AUTO-OPTIMIZATION SETTINGS
# =============================================================================

# Enable automatic performance optimization
# Adjusts settings based on hardware capabilities
# Default: true
TRANSCRIPTA_AUTO_OPTIMIZE=true

# Optimization mode preference
# maximum = best quality, speed = fastest, balanced = compromise, low_memory = conserve RAM
# Default: balanced
TRANSCRIPTA_OPTIMIZATION_MODE=balanced

# =============================================================================
# ADVANCED TRANSCRIPTION SETTINGS
# =============================================================================

# Condition on previous text for context
# Improves consistency across chunks but adds latency
# Default: true
TRANSCRIPTA_CONDITION_ON_PREVIOUS_TEXT=true

# Compression ratio threshold for quality control
# None = disabled, or set to a float value (e.g., 2.4)
# Default: None (disabled)
# TRANSCRIPTA_COMPRESSION_RATIO_THRESHOLD=

# =============================================================================
# SESSION SETTINGS
# =============================================================================

# Session maximum age in hours before auto-cleanup
# Set to 0 to disable automatic cleanup
# Default: 168 (7 days)
TRANSCRIPTA_SESSION_MAX_AGE_HOURS=168

# Session cleanup check interval in minutes
# How often to scan for and remove old session files
# Default: 60
TRANSCRIPTA_SESSION_CLEANUP_INTERVAL_MINUTES=60

# =============================================================================
# API SERVER SETTINGS
# =============================================================================

# Debug mode for development
# Set to 'true' for auto-reload and verbose error messages
# Default: false
TRANSCRIPTA_DEBUG=false

# API server host address
# Use 127.0.0.1 for local-only access (recommended for security)
# Use 0.0.0.0 to allow network access from other devices on your LAN
# Default: 127.0.0.1
TRANSCRIPTA_HOST=127.0.0.1

# API server port
# Must be available and not blocked by Windows Firewall
# Default: 8765
TRANSCRIPTA_PORT=8765

# =============================================================================
# GPU/CUDA SETTINGS
# =============================================================================

# CUDA device index to use (if multiple GPUs)
# Default: 0 (first GPU)
# CUDA_VISIBLE_DEVICES=0

# Optional: Limit GPU memory fraction (0.0 - 1.0)
# Useful when running alongside other GPU apps
# CUDA_MEMORY_FRACTION=0.8

# Optional: Force CUDA compute capability
# Only needed for very old GPUs
# CUDA_COMPUTE_CAPABILITY=7.5

# Disable CUDA for troubleshooting
# Set to 1 to force CPU-only mode at CUDA level
# Default: 0
CUDA_DISABLED=0

# Number of CUDA streams for parallel GPU processing
# Higher = more parallelization but uses more VRAM
# Only used in fast engine mode
# Default: 2
TRANSCRIPTA_NUM_CUDA_STREAMS=2

# =============================================================================
# ADVANCED SETTINGS (Modify with caution)
# =============================================================================

# Number of worker threads for STT processing
# Increase if you have many CPU cores and want more parallelism
# Default: 2
# TRANSCRIPTA_MAX_WORKERS=2

# Chunk duration in milliseconds for streaming
# Internal parameter for audio buffering
# Default: 200
# TRANSCRIPTA_CHUNK_DURATION_MS=200

# Target latency in milliseconds
# Internal performance target for processing
# Default: 500
# TRANSCRIPTA_TARGET_LATENCY_MS=500

# =============================================================================
# WINDOWS-SPECIFIC SETTINGS
# =============================================================================

# WASAPI exclusive mode (not typically needed)
# Set to true only if standard loopback fails
# WASAPI_EXCLUSIVE_MODE=false

# =============================================================================
# HUGGINGFACE CACHE (for model downloads)
# =============================================================================

# Optional: Override HuggingFace cache location
# Useful for systems with limited C: drive space
# HF_HOME=D:/HuggingFace/Cache

# Optional: Use offline mode (models must be pre-downloaded)
# TRANSFORMERS_OFFLINE=1
# HF_HUB_OFFLINE=1
